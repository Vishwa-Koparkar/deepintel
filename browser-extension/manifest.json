{
  "manifest_version": 3,
  "name": "DeepIntel URL Guard",
  "version": "1.0.0",
  "description": "Real-time URL threat detection powered by DeepIntel's 3-layer detection engine",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "webRequest",
    "webNavigation",
    "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}